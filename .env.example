# DevPilot Environment Configuration Template
# Copy this file to .env and adjust variables as required

# Application
ENVIRONMENT=development
DEBUG=true
APP_NAME=DevPilot
APP_VERSION=0.1.0-beta
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_APP_TITLE=DevPilot

# Security
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database Configuration (Default: SQLite for Docker-free local dev)
# Relative path resolves automatically to backend/devpilot.db
DATABASE_URL=sqlite:///./devpilot.db

# Optional PostgreSQL Configuration (uncomment if using PostgreSQL)
# DATABASE_URL=postgresql://devpilot:devpilot_secret@localhost:5432/devpilot_db
POSTGRES_USER=devpilot
POSTGRES_PASSWORD=devpilot_secret
POSTGRES_DB=devpilot_db
POSTGRES_PORT=5432

# Cache & Message Broker (Redis - Optional for local development)
REDIS_URL=redis://localhost:6381/0
REDIS_PORT=6381

# Celery Configuration (Optional for local development)
CELERY_BROKER_URL=redis://localhost:6381/1
CELERY_RESULT_BACKEND=redis://localhost:6381/2

# GitHub Integration (OAuth + repository sync)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/github/callback
GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback
GITHUB_WEBHOOK_SECRET=
