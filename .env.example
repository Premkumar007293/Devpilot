# DevPilot Environment Configuration Template
# Copy this file to .env and adjust variables as required

# Application
ENVIRONMENT=development
DEBUG=true
APP_NAME=DevPilot
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_APP_TITLE=DevPilot

# Security
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database (PostgreSQL)
DATABASE_URL=postgresql://devpilot:devpilot_secret@localhost:5432/devpilot_db
POSTGRES_USER=devpilot
POSTGRES_PASSWORD=devpilot_secret
POSTGRES_DB=devpilot_db
POSTGRES_PORT=5432

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI Providers (Future Phases)
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# GitHub Integration (Future Phases)
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback
